APP_NAME=Clinic AI
APP_ENV=development
DATABASE_URL=postgresql+psycopg://clinic_user:clinic_pass@localhost:5433/clinic_ai

# Local demo secret. Change this if the project is ever deployed publicly.
AUTH_SECRET=clinic-ai-local-dev-secret-change-me
ACCESS_TOKEN_MINUTES=480

# KT3 - AI. Never commit a real API key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
